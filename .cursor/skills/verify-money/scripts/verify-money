#!/usr/bin/env bash
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -d "$DIR/node_modules/playwright" || ! -d "$DIR/node_modules/embedded-postgres" ]]; then
  echo "verify-money: helper dependencies are missing. From the repo root run: npm install --prefix .cursor/skills/verify-money/scripts" >&2
  exit 1
fi
exec node "$DIR/verify-money.mjs" "$@"
